# ESPN Fantasy
ESPN_S2=your_espn_s2_cookie_here
SWID=your_swid_cookie_here
LEAGUE_ID=your_league_id_here

# Snowflake
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USER=your_user_here
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_DATABASE=your_database_here
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=your_warehouse_here
# Output scripts read from the dbt-built schema. Defaults to ANALYTICS.
# Override only if your dbt target schema is named differently.
# SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS

# Google Sheets -- optional. Configure both to enable Sheets output
# from generate_records_report.py. Leave blank/unset to skip; the
# script no-ops on the Sheets sink when SHEETS_OUTPUT_ID is empty.
# See SETUP.md for the GCP project + OAuth client creation walkthrough.
GOOGLE_OAUTH_CLIENT_PATH=
SHEETS_OUTPUT_ID=
