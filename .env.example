# ESPN Fantasy
ESPN_S2=your_espn_s2_cookie_here
SWID=your_swid_cookie_here
LEAGUE_ID=your_league_id_here

# Snowflake
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USER=your_user_here
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_DATABASE=your_database_here
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=your_warehouse_here

# Google Sheets (Phase 6.3) -- optional. Configure both to enable Sheets
# output from generate_records_report.py. Leave blank/unset to skip.
# Setup: see SETUP.md (TBD) for the GCP project + OAuth client creation.
GOOGLE_OAUTH_CLIENT_PATH=/absolute/path/to/oauth-client.json
SHEETS_OUTPUT_ID=your_target_sheet_id_here