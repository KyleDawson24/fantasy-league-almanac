# Copy this file to `.env` and fill in the first three values. Both `.env`
# and every `*.env` are gitignored, so nothing you put there can be
# committed by accident.
#
# Every field below names the SETUP.md section that tells you where its
# answer comes from. If a comment ever sends you to a section that does
# not exist, that is a bug worth an issue.
#
# QUICKSTART.md is the complete guided path; SETUP.md has the deeper reference.

# --------------------------------------------------------------------
# ESPN -- which league to pull, and how to authenticate to it
# --------------------------------------------------------------------

# This is the number in your ESPN league URL. Required: the extract reads it at
# import time and cannot start without it.
#   SETUP.md section 3 -> "Find your league ID"
LEAGUE_ID=

# Browser cookies. The supported v1.9 public command requires both, even
# for a public league; running that entrypoint without cookies has not been
# proven yet. They expire, so an extract that used to work and now returns
# nothing usually means these need refreshing.
#   SETUP.md section 3 -> "Find your cookies"
ESPN_S2=
SWID=

# --------------------------------------------------------------------
# Snowflake -- advanced alternative, not part of the v1.9 quickstart
# --------------------------------------------------------------------

# Leave this entire section blank when following QUICKSTART.md. The public
# command uses local Parquet and DuckDB unless you deliberately pass
# --advanced-snowflake. SETUP.md section 4 covers that optional route.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=

# Pick ONE auth path. Key-pair is recommended, and is REQUIRED if the
# account has MFA enforced -- the connector cannot answer an interactive
# MFA prompt, so password auth simply fails there.
#   SETUP.md section 4 -> "Authentication: key-pair (recommended) vs password"
#
# Path A, key-pair. Point this at your private key file.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only for an encrypted key.
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
#
# Path B, password. Leave SNOWFLAKE_PRIVATE_KEY_PATH unset or empty and
# the connector falls back to this.
# SNOWFLAKE_PASSWORD=

# The output scripts read from the schema dbt builds into, which defaults
# to ANALYTICS. Set this only if your dbt target schema has another name.
#   SETUP.md section 6 -> "Configure `.env`"
# SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS

# --------------------------------------------------------------------
# Google Sheets -- the release quickstart needs no values here
# --------------------------------------------------------------------
#
# Leave this section blank when following QUICKSTART.md. The release ZIP
# already carries the app's Google sign-in configuration, and the public
# command creates a new workbook in the Google account you choose.

# Path to the OAuth client JSON from your own GCP project.
#   SETUP.md section 10 -> "Create a GCP project + OAuth client"
GOOGLE_OAUTH_CLIENT_PATH=

# Advanced override only. A release user leaves this blank. Developers
# can point it at a public-workbook OAuth client of their own; a value here
# deliberately replaces the release's bundled configuration.
GOOGLE_PUBLIC_OAUTH_CLIENT_PATH=

# Existing-workbook destinations used by lower-level maintainer commands.
# The quickstart creates a new workbook and leaves both blank.
SHEETS_DEV_ID=
SHEETS_PROD_ID=

# Legacy. Still honored as a fallback for --prod when SHEETS_PROD_ID is
# unset, so older .env files keep working. Prefer SHEETS_PROD_ID for a
# new setup, and note that a value here is a PRODUCTION target rather
# than a spare slot -- whatever sheet it names is what --prod writes to.
# SHEETS_OUTPUT_ID=

# --------------------------------------------------------------------
# Everything below is off the quickstart path
# --------------------------------------------------------------------

# A second, CBS-hosted league. Not part of the v1.9 quickstart: the CBS login
# is reCAPTCHA-walled, so there is no scripted credential flow and every
# value here is browser-extracted by hand. The capture scripts treat
# these leagues as read-only.
#   SETUP.md section 6 -> "Configure `.env`", the CBS league block
# CBS_LEAGUE=
# CBS_TOKEN=
# CBS_WEB_COOKIES=
# CBS_SHEETS_DEV_ID=
# CBS_SHEETS_OUTPUT_ID=

# DuckDB target knobs. Local DuckDB IS the supported public path now:
# `tools/create_public_almanac.py` lands RAW as parquet under
# data/parquet/raw/, loads it into DuckDB, and builds from there, passing
# the paths and options it needs itself. So these two are optional
# overrides rather than setup -- leave them unset and the release journey
# works. Every SNOWFLAKE_* field above can stay empty on that path;
# Snowflake is reached only by deliberately passing --advanced-snowflake.
#   ALMANAC_DB_BACKEND=duckdb makes the output scripts read DuckDB
#   without passing --duckdb on every call.
#   DBT_DUCKDB_PATH points at the database file.
# ALMANAC_DB_BACKEND=
# DBT_DUCKDB_PATH=
